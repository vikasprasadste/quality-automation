{
  "name": "@edvantaze/quality-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Central quality automation for Edvantaze web, admin, mobile, API, and future AI features.",
  "scripts": {
    "test:web": "playwright test --project=web-chromium",
    "test:admin": "playwright test --project=admin-chromium",
    "test:web:all": "playwright test",
    "test:mobile": "mobilewright test",
    "test:api": "python -m pytest tests/api",
    "test:ai": "python -m pytest tests/ai_evals",
    "test:python": "python -m pytest",
    "lint:python": "ruff check tests python_support",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.11.1",
    "dotenv": "^17.2.1",
    "mobilewright": "^0.0.55",
    "@mobilewright/test": "^0.0.55",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
